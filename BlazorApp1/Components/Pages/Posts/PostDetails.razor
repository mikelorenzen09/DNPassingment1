@page "/posts/{PostId:int}"
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<PageTitle>Post</PageTitle>

<a class="back-link" href="posts">&larr; All posts</a>

@if (errorMessage is not null)
{
    <div class="alert-error">@errorMessage</div>
}
else if (post is null)
{
    <p class="loading">Loading post...</p>
}
else
{
    <article class="post-article">
        <h1><span class="page-title">@post.Title</span></h1>
        <div class="byline">
            <span class="avatar">@UiHelpers.Initial(authorName)</span>
            <span>Written by <strong>@authorName</strong></span>
        </div>
        <div class="post-body">@post.Body</div>
    </article>

    <h3 class="section-title">
        Comments
        <span class="count">(@(comments?.Count ?? 0))</span>
    </h3>

    @if (comments is null || comments.Count == 0)
    {
        <div class="empty-state mb-4">
            <strong>No comments yet</strong>
            Start the conversation.
        </div>
    }
    else
    {
        <ul class="comment-list">
            @foreach (CommentDto comment in comments)
            {
                string commenter = GetAuthorName(comment.UserID);
                <li class="comment">
                    <span class="avatar avatar-sm">@UiHelpers.Initial(commenter)</span>
                    <div>
                        <div class="comment-author">@commenter</div>
                        <p class="comment-body">@comment.Body</p>
                    </div>
                </li>
            }
        </ul>
    }

    <AuthorizeView>
        <NotAuthorized>
            <div class="panel">
                <a href="login">Log in</a> to add a comment.
            </div>
        </NotAuthorized>
        <Authorized>
            <div class="panel">
                <label>Add a comment</label>
                <textarea class="form-control" rows="3" @bind="newCommentBody" placeholder="Share your thoughts..."></textarea>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="AddComment">Post comment</button>
                </div>

                @if (!string.IsNullOrEmpty(commentError))
                {
                    <div class="alert-error">@commentError</div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int PostId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private PostDto? post;
    private List<CommentDto>? comments;
    private Dictionary<int, string> usernamesById = new();
    private string authorName = "";
    private string newCommentBody = "";
    private string? errorMessage;
    private string? commentError;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            string? idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (idClaim is not null)
            {
                currentUserId = int.Parse(idClaim);
            }
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            List<UserDto> users = await UserService.GetUsersAsync();
            usernamesById = users.ToDictionary(u => u.UserID, u => u.Username);

            post = await PostService.GetPostAsync(PostId);
            authorName = GetAuthorName(post.UserID);

            comments = await CommentService.GetCommentsForPostAsync(PostId);
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }

    private async Task AddComment()
    {
        commentError = null;

        if (string.IsNullOrWhiteSpace(newCommentBody))
        {
            commentError = "Comment can't be empty.";
            return;
        }

        try
        {
            await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = newCommentBody,
                UserID = currentUserId,
                PostID = PostId
            });

            newCommentBody = "";
            comments = await CommentService.GetCommentsForPostAsync(PostId);
        }
        catch (Exception e)
        {
            commentError = e.Message;
        }
    }

    private string GetAuthorName(int userId)
    {
        return usernamesById.TryGetValue(userId, out string? name) ? name : $"user #{userId}";
    }
}
