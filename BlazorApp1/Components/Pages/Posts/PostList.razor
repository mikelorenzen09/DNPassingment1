@page "/posts"
@inject IPostService PostService
@inject IUserService UserService

<PageTitle>Posts</PageTitle>

<div class="page-header">
    <div>
        <h1><span class="page-title">Posts</span></h1>
        @if (posts is not null)
        {
            <p class="lede">@posts.Count @(posts.Count == 1 ? "post" : "posts") so far.</p>
        }
    </div>
    <a class="btn btn-primary" href="/posts/create">Write a post</a>
</div>

@if (errorMessage is not null)
{
    <div class="alert-error">@errorMessage</div>
}
else if (posts is null)
{
    <p class="loading">Loading posts...</p>
}
else if (posts.Count == 0)
{
    <div class="empty-state">
        <strong>No posts yet</strong>
        Be the first to write something.
    </div>
}
else
{
    <ul class="post-list">
        @foreach (PostDto post in posts)
        {
            string author = GetAuthorName(post.UserID);
            <li>
                <a class="post-row" href="@($"/posts/{post.PostID}")">
                    <h2>@post.Title</h2>
                    <p>@post.Body</p>
                    <div class="byline">
                        <span class="avatar avatar-sm">@UiHelpers.Initial(author)</span>
                        <span>by <strong>@author</strong></span>
                    </div>
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<PostDto>? posts;
    private Dictionary<int, string> usernamesById = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<UserDto> users = await UserService.GetUsersAsync();
            usernamesById = users.ToDictionary(u => u.UserID, u => u.Username);

            posts = await PostService.GetPostsAsync();
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }

    private string GetAuthorName(int userId)
    {
        return usernamesById.TryGetValue(userId, out string? name) ? name : $"user #{userId}";
    }
}
