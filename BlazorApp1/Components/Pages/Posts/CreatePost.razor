@page "/posts/create"
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Create Post</PageTitle>

<div class="page-header">
    <div>
        <h1><span class="page-title">Write a post</span></h1>
        <p class="lede">Give it a clear title and say what's on your mind.</p>
    </div>
</div>

<AuthorizeView>
    <NotAuthorized>
        <div class="empty-state">
            <strong>You need to be logged in</strong>
            Log in to create a post.
            <div class="mt-3"><a class="btn btn-primary" href="login">Log in</a></div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="panel">
            <div class="mb-3">
                <label>Title</label>
                <input class="form-control" @bind="title" placeholder="What is your post about?"/>
            </div>
            <div class="mb-3">
                <label>Body</label>
                <textarea class="form-control" rows="8" @bind="body" placeholder="Write your post..."></textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Submit">Publish</button>
                <a class="btn btn-ghost" href="posts">Cancel</a>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string title = "";
    private string body = "";
    private string? errorMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            string? idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (idClaim is not null)
            {
                currentUserId = int.Parse(idClaim);
            }
        }
    }

    private async Task Submit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Title and body are required.";
            return;
        }

        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserID = currentUserId
            });

            Navigation.NavigateTo($"/posts/{created.PostID}");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }
}
