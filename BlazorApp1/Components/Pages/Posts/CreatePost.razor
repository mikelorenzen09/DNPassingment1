@page "/posts/create"
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Create Post</PageTitle>

<h1>Create a new post</h1>

<div class="mb-3">
    <label>Title</label>
    <input class="form-control" @bind="title"/>
</div>
<div class="mb-3">
    <label>Body</label>
    <textarea class="form-control" @bind="body"></textarea>
</div>

<button class="btn btn-primary" @onclick="Submit">Create post</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@code {
    private string title = "";
    private string body = "";
    private string? errorMessage;

    // No login system yet (see assignment Step 5.3) - new posts are hardcoded to user id 1.
    // Make sure you have created a user with id 1 first (Add User page).
    private const int CurrentUserId = 1;

    private async Task Submit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Title and body are required.";
            return;
        }

        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserID = CurrentUserId
            });

            Navigation.NavigateTo($"/posts/{created.PostID}");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }
}
