@page "/posts/create"
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Create Post</PageTitle>

<h1>Create a new post</h1>

<AuthorizeView>
    <NotAuthorized>
        <p class="text-danger">You must be logged in to create a post. <a href="login">Log in</a></p>
    </NotAuthorized>
    <Authorized>
        <div class="mb-3">
            <label>Title</label>
            <input class="form-control" @bind="title"/>
        </div>
        <div class="mb-3">
            <label>Body</label>
            <textarea class="form-control" @bind="body"></textarea>
        </div>

        <button class="btn btn-primary" @onclick="Submit">Create post</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="text-danger mt-3">@errorMessage</p>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string title = "";
    private string body = "";
    private string? errorMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            string? idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (idClaim is not null)
            {
                currentUserId = int.Parse(idClaim);
            }
        }
    }

    private async Task Submit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Title and body are required.";
            return;
        }

        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserID = currentUserId
            });

            Navigation.NavigateTo($"/posts/{created.PostID}");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }
}
