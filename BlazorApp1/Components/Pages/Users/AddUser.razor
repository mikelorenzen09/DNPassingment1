@page "/users/add"
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Add User</PageTitle>

<div class="page-header">
    <div>
        <h1><span class="page-title">Add user</span></h1>
        <p class="lede">Create a new account that can log in and post.</p>
    </div>
</div>

<div class="panel form-panel">
    <div class="mb-3">
        <label>Username</label>
        <input class="form-control" @bind="username" placeholder="e.g. jane"/>
    </div>
    <div class="mb-3">
        <label>Password</label>
        <input type="password" class="form-control" @bind="password" placeholder="Choose a password"/>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" @onclick="Submit">Create user</button>
        <a class="btn btn-ghost" href="posts">Cancel</a>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-error">@errorMessage</div>
    }
</div>

@code {
    private string username = "";
    private string password = "";
    private string? errorMessage;

    private async Task Submit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        try
        {
            UserDto created = await UserService.AddUserAsync(new CreateUserDto
            {
                Username = username,
                Password = password
            });

            Navigation.NavigateTo("/posts");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }
}
