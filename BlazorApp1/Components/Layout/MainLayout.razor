@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="user-chip">
                        <span class="avatar avatar-sm">@UiHelpers.Initial(context.User.Identity?.Name)</span>
                        <span>Signed in as <strong>@context.User.Identity?.Name</strong></span>
                    </div>
                    <button class="btn btn-ghost btn-sm" @onclick="LogoutAsync">Log out</button>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary btn-sm" href="login">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await ((SimpleAuthProvider)AuthProvider).Logout();
    }
}
